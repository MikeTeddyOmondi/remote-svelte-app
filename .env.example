# Read by `vite dev` and by drizzle-kit. See .dev.vars.example for the
# wrangler/production equivalents — both files must be kept in sync.

# Cloudflare D1 — used only by drizzle-kit studio (d1-http driver)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_DATABASE_ID=""
CLOUDFLARE_D1_TOKEN=""

ORIGIN="http://localhost:5173"

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Locci OpenAuth (https://auth.locci.cloud)
# Register redirect URI: <ORIGIN>/api/auth/oauth2/callback/locci-auth
LOCCI_CLIENT_ID=""
LOCCI_CLIENT_SECRET=""
