/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "remote-svelte-app",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat", "nodejs_als"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "observability": {
    "enabled": true
  },
  /**
   * Attaches the custom domain on deploy. Requires `mt0.dev` to be a zone on
   * this same Cloudflare account — if it is not, `wrangler deploy` fails; drop
   * this block and `vars.ORIGIN` below, and `createAuth` falls back to the
   * request origin (the *.workers.dev URL).
   */
  "routes": [
    {
      "pattern": "remote-svelte-app.mt0.dev",
      "custom_domain": true
    }
  ],
  "upload_source_maps": true,
  /**
   * Smart Placement
   * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  // "placement": {  "mode": "smart" }
  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "remote-svelte-app",
      "database_id": "521f8cda-b887-479f-8007-8bf9001aca6c",
      // Drizzle writes migrations here; `wrangler d1 migrations apply` is the
      // only path that reaches the LOCAL miniflare database.
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    // Production origin; overridden by .dev.vars locally. Better Auth derives
    // its cookie and CSRF checks from this, and the Locci redirect URI must be
    // https://remote-svelte-app.mt0.dev/api/auth/oauth2/callback/locci-auth
    "ORIGIN": "https://remote-svelte-app.mt0.dev",
    // Public OAuth identifier, not a secret — it travels in the authorize URL.
    // Also what `isLocciEnabled` keys off to render the sign-in button.
    // The client secret stays unset: Locci is a public PKCE client.
    "LOCCI_CLIENT_ID": "remote-svelte-app"
  }
  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   * Note: Use secrets to store sensitive data.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */
  // "vars": {  "MY_VARIABLE": "production_value" }
  /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
  // "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
